<Window x:Class="Session_8.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Session_8"
        mc:Ignorable="d"
        Title="MainWindow" Height="350" Width="253">
    <Grid>
        <Border BorderBrush="Black" BorderThickness="1" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top">
            <Label x:Name="numberDisplay" Content="Label" Width="186" HorizontalAlignment="Center"/>
        </Border>
        <Button Content="7" Width="40" Height="40" FontSize="20" FontWeight="Bold" HorizontalAlignment="Left" Margin="10,51,0,0" VerticalAlignment="Top" Click="Button_Click"/>
        <Button Content="8" Width="40" Height="40" FontSize="20" FontWeight="Bold" HorizontalAlignment="Left" Margin="60,51,0,0" VerticalAlignment="Top" Click="Button_Click"/>
        <Button Content="9" Width="40" Height="40" FontSize="20" FontWeight="Bold" HorizontalAlignment="Left" Margin="110,51,0,0" VerticalAlignment="Top" Click="Button_Click"/>
        <Button Content="4" Width="40" Height="40" FontSize="20" FontWeight="Bold" HorizontalAlignment="Left" Margin="10,101,0,0" VerticalAlignment="Top" Click="Button_Click"/>
        <Button Content="5" Width="40" Height="40" FontSize="20" FontWeight="Bold" HorizontalAlignment="Left" Margin="60,101,0,0" VerticalAlignment="Top" Click="Button_Click"/>
        <Button Content="6" Width="40" Height="40" FontSize="20" FontWeight="Bold" HorizontalAlignment="Left" Margin="110,101,0,0" VerticalAlignment="Top" Click="Button_Click"/>
        <Button Content="1" Width="40" Height="40" FontSize="20" FontWeight="Bold" HorizontalAlignment="Left" Margin="10,151,0,0" VerticalAlignment="Top" Click="Button_Click"/>
        <Button Content="2" Width="40" Height="40" FontSize="20" FontWeight="Bold" HorizontalAlignment="Left" Margin="60,151,0,0" VerticalAlignment="Top" Click="Button_Click"/>
        <Button Content="3" Width="40" Height="40" FontSize="20" FontWeight="Bold" HorizontalAlignment="Left" Margin="110,151,0,0" VerticalAlignment="Top" Click="Button_Click"/>
        <Button Content="0" Width="40" Height="40" FontSize="20" FontWeight="Bold" HorizontalAlignment="Left" Margin="10,201,0,0" VerticalAlignment="Top" Click="Button_Click"/>
        <Button Content="." Width="40" Height="40" FontSize="20" FontWeight="Bold" HorizontalAlignment="Left" Margin="60,201,0,0" VerticalAlignment="Top" Click="Button_Click"/>
        <Button Content="C" Width="40" Height="40" FontSize="20" FontWeight="Bold" HorizontalAlignment="Left" Margin="110,201,0,0" VerticalAlignment="Top" Click="Button_Click"/>

        <Button Content="*" Width="40" Height="40" FontSize="20" FontWeight="Bold" HorizontalAlignment="Left" Margin="160,51,0,0" VerticalAlignment="Top" Click="Operator_Click"/>
        <Button Content="/" Width="40" Height="40" FontSize="20" FontWeight="Bold" HorizontalAlignment="Left" Margin="160,101,0,0" VerticalAlignment="Top" Click="Operator_Click"/>
        <Button Content="+" Width="40" Height="40" FontSize="20" FontWeight="Bold" HorizontalAlignment="Left" Margin="160,151,0,0" VerticalAlignment="Top" Click="Operator_Click"/>
        <Button Content="-" Width="40" Height="40" FontSize="20" FontWeight="Bold" HorizontalAlignment="Left" Margin="160,201,0,0" VerticalAlignment="Top" Click="Operator_Click"/>
        <Button Content="=" Width="190" Height="40" FontSize="20" FontWeight="Bold" HorizontalAlignment="Left" Margin="10,251,0,0" VerticalAlignment="Top" Click="Equals_Click"/>
        <!--Button Content="Button" HorizontalAlignment="Left" Margin="10,246,0,0" VerticalAlignment="Top" Click="Button_Click_1"/-->
    </Grid>
</Window>
